Dir {
	ArchiveDir ".";
	CacheDir "./cache";
};

Default {
	Packages::Compress ". gzip bzip2";
	Sources::Compress ". gzip bzip2";
	Contents::Compress ". gzip bzip2";
};

TreeDefault {
	BinCacheDB "packages-${SUITE}-$(SECTION)-$(ARCH).db";
};

Tree "${SUITE}" {
	Sections "${COMPONENTS}";
	Architectures "${ARCHITECTURES}";
	Directory "pool/${SUITE}/$(SECTION)/";
	Packages "dists/${SUITE}/$(SECTION)/binary-$(ARCH)/Packages";
	Contents "dists/${SUITE}/Contents-$(ARCH)";
}
